rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny Catch-All Security Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.uid == 'WNCq0kNNYbeCLNAGS0TXPsMqfP02'
      );
    }

    // Server Operations Collection - Internal only (Managed purely server-side by Admin SDK)
    match /operations/{opId} {
      allow read, write: if false;
    }

    // Users Collection
    match /users/{uid} {
      // User can read their own profile, credits, and history. Authorized Admins can read any user.
      allow read: if isOwner(uid) || isAdmin();
      
      // Allow user to create initial profile doc safely with bounded starter defaults
      allow create: if isOwner(uid) &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.credits >= 0 && request.resource.data.credits <= 100 &&
        (request.resource.data.plan == 'free' || request.resource.data.plan == 'creator' || request.resource.data.plan == 'starter' || request.resource.data.plan == 'pro') &&
        (!('role' in request.resource.data) || request.resource.data.role == 'creator') &&
        (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false);
        
      allow delete: if false;
        
      // If a user updates their own profile, billing, credit, and audit fields are strictly protected.
      // Admins are allowed to update user fields server-side or directly if authorized.
      allow update: if (isOwner(uid) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'credits',
          'plan',
          'videosCreatedCount',
          'totalCreditsUsed',
          'createdAt',
          'role',
          'isAdmin',
          'refunded',
          'cost',
          'activeGenerations',
          'recentGenerationTimestamps',
          'uid',
          'id'
        ])) || isAdmin();

      // Credit Transactions Ledger: Read-only for owner or admin, written solely by Server Admin SDK
      match /creditTransactions/{transactionId} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if false;
      }

      // Server Video Generation Records: Read-only for owner or admin, written solely by Server Admin SDK
      match /generations/{generationId} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if false;
      }

      // User Workflows & Resources
      match /folders/{folderId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
      match /files/{fileId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
      match /notes/{noteId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
      match /teamMembers/{memberId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
      match /videos/{videoId} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if isOwner(uid) || isAdmin();
      }
    }
  }
}
